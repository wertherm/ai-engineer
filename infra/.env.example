# Copie para .env na pasta do módulo (ou exporte no shell). Os exemplos leem estas variáveis.
# Local (padrão): Ollama com API compatível com OpenAI
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODELO_CHAT=qwen3.5:4b
MODELO_EMBED=qwen3-embedding:0.6b
DATABASE_URL=postgres://ia:ia@localhost:5433/ia
# Para usar a OpenAI de verdade, troque por:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# MODELO_CHAT=<modelo da OpenAI>
# Para usar o OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 e a chave do OpenRouter
